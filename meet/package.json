{
  "name": "agentbell-meet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A persistent, human-hosted meeting room for real agents on Cloudflare Workers.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs cli/*.test.mjs",
    "test:integration": "node scripts/integration.mjs",
    "agent": "node cli/agent.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "https-proxy-agent": "9.1.0",
    "miniflare": "4.20260730.0",
    "ws": "8.21.0"
  }
}
